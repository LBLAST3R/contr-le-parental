# === Configuration Guardian (app parents) ===
# Copie ce fichier en .env et remplis. Sur Hostinger, mets ces valeurs dans
# les "variables d'environnement" du panneau Node.js (PAS dans le dépôt Git).

# Mot de passe unique des parents pour accéder au tableau de bord.
PARENT_PASSWORD=James85*

# Secret pour signer les cookies de session (LONG et aléatoire).
# Génère-en un avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (si vide, l'app en génère un et le garde dans data/, mais fixe-le en prod.)
SESSION_SECRET=

# Clé que l'agent sur le PC de James doit présenter (X-API-Key).
# DOIT être identique à "api_key" dans la config de l'agent.
AGENT_API_KEY=change-moi-cle-agent-longue-et-aleatoire

# Port d'écoute (Hostinger le fournit automatiquement ; 3000 en local).
PORT=3000

# Combien de jours la session parent reste valide sans re-taper le mot de passe.
SESSION_DAYS=90

# Délai (s) sans heartbeat avant l'alerte "agent injoignable".
HEARTBEAT_TIMEOUT_SECONDS=600

# --- Telegram (facultatif : alertes temps réel + boutons) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHATS=
TELEGRAM_DISTRESS_CHATS=
